  66          void MT_TFTLCD_DrawLine(unsigned int x1,unsigned int y1,unsigned int x2,unsigned int y2,unsigned int color
             -)
  67          {
  68   1        unsigned int xdata t; 
  69   1        int xerr=0,yerr=0,delta_x,delta_y,distance;
  70   1        int incx,incy,uRow,uCol;
