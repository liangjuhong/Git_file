  88   1          incy=0;//水平线 
  89   1        else 
  90   1        {
  91   2          incy=-1;
  92   2          delta_y=-delta_y;
  93   2        }
  94   1      
  95   1        if(delta_x>delta_y)
  96   1          distance=delta_x; //选取基本增量坐标轴 
  97   1        else 
  98   1          distance=delta_y;
