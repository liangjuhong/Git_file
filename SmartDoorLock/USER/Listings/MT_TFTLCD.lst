 123          //显示一个字符
 124          /*
 125          显示X轴起始值：xsta
 126          显示Y轴起始值：ysta
 127          字符串首地址：p
 128          字体颜色：fcolor
 129          背景颜色：bcolor
 130          字体尺寸：fsizey
 131          模式：mode 0非叠加模式 1叠加模式
 132          */
 133          void MT_TFTLCD_ShowChar(unsigned char xsta,unsigned char ysta,unsigned short num,unsigned short fcolor,uns
             -igned short bcolor,unsigned char fsizey,unsigned char mode)
 134          {
 135   1        unsigned char xdata i,m,x0,t;
 136   1        unsigned short xdata temp,numx;
 137   1        unsigned char xdata fsizex;//字符水平方向像素
 138   1        unsigned char xdata fontnumber;//一个字符占有的字节数
 139   1        num=num-' ';//传入字符的偏移量
 140   1        numx=num-'0';
 141   1        x0=xsta;
 142   1        fsizex=fsizey/2;
 143   1        fontnumber=(fsizex/8+((fsizex%8)?1:0))*fsizey;
 144   1        MT_TFTLCD_ADDRESS_SET(xsta,ysta,xsta+fsizex-1,ysta+fsizey-1);//设置一个字符的屏显范围
 145   1        for(i=0;i<fontnumber;i++)
 146   1        {
 147   2          if(fsizey==12)
 148   2            temp=ascii_1206[num][i];
 149   2          else if(fsizey==16)
 150   2            temp=ascii_1608[num][i];
 151   2          else if(fsizey==24)
 152   2            temp=ascii_2412[num][i];
 153   2          else if(fsizey==32)
 154   2            temp=ascii_3216[num][i];
 155   2          else if(fsizey==48)
 156   2            temp=ascii_4824[numx][i];
 157   2          else
 158   2            return;
 159   2          for(m=0;m<8;m++)
 160   2          {
 161   3            if(!mode)//非叠加模式，具有自动刷新的功能
 162   3            {
 163   4              if(temp & (0x01<<m) )
 164   4              HAL_TFTLCD_WRData16(fcolor);//字体颜色
 165   4              else
 166   4              HAL_TFTLCD_WRData16(bcolor);//背景颜色
 167   4              t++;
 168   4              if(t%fsizex==0)//一个字符的水平像素为fsizex
 169   4              {
 170   5                t=0;
 171   5                break;
 172   5              }
 173   4            }
 174   3            else//叠加模式，没有自动刷新的功能
C51 COMPILER V9.59.0.0   MT_TFTLCD                                                         05/13/2026 22:47:36 PAGE 4   

 175   3            {
 176   4              if(temp & (0x01<<m) )
 177   4              MT_TFTLCD_PointColor(xsta,ysta,fcolor);
 178   4              xsta++;
 179   4              if((xsta-x0)==fsizex)
 180   4              {
 181   5                xsta=x0;
 182   5                ysta++;
 183   5                break;
 184   5              }
 185   4            }
 186   3          }
 187   2        }
 188   1      }
