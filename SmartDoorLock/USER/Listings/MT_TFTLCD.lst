 238          /*显示图片,图片像素为24*30*/
 239          void MT_TFTLCD_ShowPicture(unsigned short xsta,unsigned short ysta,unsigned short xlen,unsigned short ylen
             -, const unsigned char *p,unsigned short fcolor,unsigned short bcolor)
 240          {
 241   1        unsigned char xdata i,j,t,x0;
 242   1        unsigned short xdata temp;
 243   1        x0=xlen/8;
 244   1        MT_TFTLCD_ADDRESS_SET(xsta,ysta,xsta+xlen-1,ysta+ylen-1);
 245   1        for(i=0;i<x0;i++)
 246   1        {
 247   2          for(j=0;j<ylen;j++)
 248   2          {
 249   3            temp=*p;
 250   3            for(t=0;t<8;t++)
 251   3            {
 252   4              if(temp&0x80)
 253   4              {
 254   5                HAL_TFTLCD_WRData16(fcolor);
 255   5              }
 256   4              else
 257   4              {
 258   5                HAL_TFTLCD_WRData16(bcolor);
 259   5              }
 260   4              temp<<=1;
 261   4            }
 262   3            p++;
 263   3          }
 264   2        }
 265   1      }
